{
  "name": "@nestjs-odata/core",
  "version": "2.0.0",
  "description": "Core OData v4 library for NestJS — parser, EDM, decorators, module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cberd1509/nestjs-odata.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cberd1509/nestjs-odata#readme",
  "bugs": {
    "url": "https://github.com/cberd1509/nestjs-odata/issues"
  },
  "keywords": [
    "nestjs",
    "odata",
    "odata-v4",
    "rest",
    "api",
    "edm",
    "metadata",
    "nestjs-module"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@swc/core": "^1.15.33",
    "@types/node": "24",
    "@types/pluralize": "^0.0.33",
    "@vitest/coverage-v8": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  }
}
