{
  "name": "@nestjs-odata/core",
  "version": "2.3.0",
  "description": "Core OData v4 library for NestJS — parser, EDM, decorators, module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cberd1509/nestjs-odata.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cberd1509/nestjs-odata#readme",
  "bugs": {
    "url": "https://github.com/cberd1509/nestjs-odata/issues"
  },
  "keywords": [
    "nestjs",
    "odata",
    "odata-v4",
    "rest",
    "api",
    "edm",
    "metadata",
    "nestjs-module"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "@types/pluralize": "^0.0.33",
    "@vitest/coverage-v8": "^4.1.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  }
}
