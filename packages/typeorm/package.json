{
  "name": "@nestjs-odata/typeorm",
  "version": "2.0.0",
  "description": "TypeORM adapter for @nestjs-odata/core — auto-derives OData EDM from TypeORM entity metadata",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cberd1509/nestjs-odata.git",
    "directory": "packages/typeorm"
  },
  "homepage": "https://github.com/cberd1509/nestjs-odata#readme",
  "bugs": {
    "url": "https://github.com/cberd1509/nestjs-odata/issues"
  },
  "keywords": [
    "nestjs",
    "odata",
    "odata-v4",
    "typeorm",
    "rest",
    "api",
    "edm",
    "orm-adapter"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@nestjs-odata/core": ">=2.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs-odata/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@nestjs/typeorm": "^11.0.0",
    "@swc/core": "^1.15.24",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "24",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^12.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "tsdown": "^0.21.7",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
