{
  "name": "nestjs-odata",
  "version": "0.0.1",
  "private": true,
  "description": "OData v4 library for NestJS — Turborepo monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "pnpm": {
    "overrides": {
      "typescript": "$typescript",
      "fflate": "0.8.2",
      "axios": "^1.16.1",
      "fast-uri": "^3.1.2",
      "postcss": "^8.5.15",
      "uuid": "^11.1.1",
      "qs": "^6.15.2",
      "follow-redirects": "^1.16.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
